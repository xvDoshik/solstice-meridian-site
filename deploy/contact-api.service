[Unit]
Description=Clinic Contact API
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/clinic-contact
EnvironmentFile=/etc/clinic-contact.env
ExecStart=/usr/bin/python3 /opt/clinic-contact/app.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/clinic-inquiries

[Install]
WantedBy=multi-user.target
